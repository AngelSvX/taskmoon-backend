generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl"]
  moduleFormat  = "cjs"
}

datasource db {
  provider = "mysql"
}

model permissions {
  id               Int                @id @default(autoincrement()) @db.UnsignedSmallInt
  name             String             @unique(map: "uq_permissions_name") @db.VarChar(100)
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       Int         @db.UnsignedSmallInt
  permission_id Int         @db.UnsignedSmallInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_role_permissions_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "fk_role_permissions_permission")
}

model roles {
  id               Int                @id @default(autoincrement()) @db.UnsignedSmallInt
  name             String             @unique(map: "uq_roles_name") @db.VarChar(50)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model user_credentials {
  user_id             Int       @id @db.UnsignedInt
  password_hash       String    @db.VarChar(255)
  password_changed_at DateTime  @default(now()) @db.DateTime(0)
  failed_attempts     Int       @default(0) @db.UnsignedInt
  locked_until        DateTime? @db.DateTime(0)
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_credentials_user")
}

model user_roles {
  user_id Int   @db.UnsignedInt
  role_id Int   @db.UnsignedSmallInt
  roles   roles @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_roles_role")
  users   users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_roles_user")

  @@id([user_id, role_id])
  @@index([role_id], map: "fk_user_roles_role")
}

model user_sessions {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  user_id      Int       @db.UnsignedInt
  token_hash   String    @unique(map: "uq_sessions_token") @db.VarChar(512)
  ip_address   String?   @db.VarChar(45)
  user_agent   String?   @db.VarChar(512)
  created_at   DateTime  @default(now()) @db.DateTime(0)
  last_used_at DateTime? @db.DateTime(0)
  expires_at   DateTime  @db.DateTime(0)
  revoked_at   DateTime? @db.DateTime(0)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_sessions_user")

  @@index([expires_at], map: "idx_sessions_expires")
  @@index([user_id], map: "idx_sessions_user")
}

model users {
  id                Int                @id @default(autoincrement()) @db.UnsignedInt
  email             String             @unique(map: "uq_users_email") @db.VarChar(320)
  username          String?            @unique(map: "uq_users_username") @db.VarChar(100)
  display_name      String?            @db.VarChar(150)
  status            users_status       @default(active)
  email_verified_at DateTime?          @db.DateTime(0)
  created_at        DateTime           @default(now()) @db.DateTime(0)
  updated_at        DateTime           @default(now()) @db.DateTime(0)
  user_credentials  user_credentials?
  user_roles        user_roles[]
  user_sessions     user_sessions[]
  workspaces        workspace[]
  workspace_members workspace_member[]
}

model workspace {
  id          Int             @id @default(autoincrement()) @db.UnsignedInt
  ownerId     Int             @map("owner_id") @db.UnsignedInt
  name        String          @db.VarChar(120)
  description String?
  icon        String?
  slug        String          @unique @db.VarChar(140)
  status      WorkspaceStatus @default(active)
  settings    Json?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  workspace_member workspace_member[]
  owner            users              @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("workspaces")
}

model workspace_role {
  id          Int    @id @default(autoincrement()) @db.UnsignedSmallInt
  name        String @unique @db.VarChar(50) // owner, admin, member, viewer
  permissions Json? // o tabla aparte si crece

  members workspace_member[]

  @@map("workspace_roles")
}

model workspace_member {
  workspaceId Int      @map("workspace_id") @db.UnsignedInt
  userId      Int      @map("user_id") @db.UnsignedInt
  roleId      Int      @map("role_id") @db.UnsignedSmallInt
  joinedAt    DateTime @default(now()) @map("joined_at")
  invitedAt   DateTime @default(now()) @map("invited_at")

  workspace workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      workspace_role @relation(fields: [roleId], references: [id])

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model task_priority {
  id   Int    @id @default(autoincrement()) @db.UnsignedTinyInt
  name String @unique @db.VarChar(30)
}

enum WorkspaceStatus {
  active
  archived
}

enum users_status {
  active
  inactive
  suspended
}
